rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isApproved() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'approved';
    }
    
    function isAdmin() {
      return isApproved() && getUserData().role == 'Administrador';
    }

    function isSupervisorOrAdmin() {
      return isApproved() && (getUserData().role == 'Administrador' || getUserData().role == 'Supervisor');
    }
    
    function isPermanentAdmin(uid) {
      return request.auth.token.email == 'marketing.hseconsultoria@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(uid)) && 
         get(/databases/$(database)/documents/users/$(uid)).data.email == 'marketing.hseconsultoria@gmail.com');
    }

    // Users Collection
    match /users/{userId} {
      // Anyone authenticated can read user documents (or read their own)
      allow read: if isAuthenticated();
      
      // Self registration or permanent admin initialization
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId && 
         request.resource.data.status == 'pending' &&
         request.resource.data.role == 'Limitado') ||
        (request.auth.uid == userId &&
         request.resource.data.email == 'marketing.hseconsultoria@gmail.com' &&
         request.resource.data.status == 'approved' &&
         request.resource.data.role == 'Administrador')
      );

      // Updates
      allow update: if isAuthenticated() && (
        // User can update their own non-sensitive fields
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isPermanentAdmin'])) ||
        // Admin can update roles and status, BUT CANNOT edit permanent admin
        (isAdmin() && !isPermanentAdmin(userId)) ||
        // Permanent admin editing themselves
        (isPermanentAdmin(request.auth.uid) && userId == request.auth.uid)
      );

      // Delete user
      allow delete: if isAdmin() && !isPermanentAdmin(userId);
    }

    // Collaborators Collection
    match /collaborators/{collabId} {
      allow read: if isApproved();
      allow create, update: if isSupervisorOrAdmin();
      allow delete: if isAdmin();
    }

    // Form Fields Collection
    match /formFields/{fieldId} {
      allow read: if isApproved();
      allow create, update: if isSupervisorOrAdmin();
      allow delete: if isAdmin();
    }

    // Records Collection
    match /records/{recordId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }

    // Drafts Collection
    match /drafts/{draftId} {
      allow read, create, update, delete: if isApproved() && 
        (resource == null || resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == request.auth.uid);
    }

    // Audit Log Collection
    match /auditLog/{logId} {
      allow read: if isSupervisorOrAdmin();
      allow create: if isApproved();
    }
  }
}
